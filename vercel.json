{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [{ "source": "/mcp", "destination": "/api/mcp" }],
  "functions": { "api/mcp.ts": { "maxDuration": 60 } },
  "headers": [
    {
      "source": "/mcp",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
