# Copy to .env for local runs (`npm run dev`). Never commit .env.

# --- Smoobu credentials (account-wide; keep secret) ---
# Preferred: HMAC auth (Smoobu > Settings > Advanced > API Keys). Set BOTH values.
SMOOBU_API_KEY=
SMOOBU_API_SECRET=
# If SMOOBU_API_SECRET is empty the client falls back to the legacy `Api-Key`
# header, which Smoobu sunsets on 2026-10-31.

# Smoobu customer (user) id, required by /booking/checkApartmentAvailability.
SMOOBU_CUSTOMER_ID=

# Public booking page. Placeholders: {property} {arrival} {departure} {guests}
BOOKING_URL_TEMPLATE=https://example.com/book?property={property}&from={arrival}&to={departure}&guests={guests}

# --- Optional tuning ---
# SMOOBU_BASE_URL=https://login.smoobu.com   # only for pointing at a mock in tests; leave unset
# PORT=3000                      # local dev server port
# RATE_LIMIT_PER_MINUTE=60       # per-IP token bucket refill rate
# RATE_LIMIT_BURST=20            # per-IP bucket size
# CACHE_TTL_RATES_SECONDS=300
# CACHE_TTL_AVAILABILITY_SECONDS=120
